    "        self.tokenize_text()\n",
    "        self.trainWord2Vec_model()\n",
    "        self.average_word_vector_to_df()\n",
    "        self.get_model_inputs()\n",
    "        self.train_KNN_model()\n",
    "        self.train_kmeans_model()\n",
    "        self.RandomForest_for_clusters()"
